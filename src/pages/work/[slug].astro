---
import Header from "../../layouts/Header.astro";
import { caseStudies, getAdjacent } from "../../data/case-studies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study, ...getAdjacent(study.slug) },
  }));
}

const { study, prev, next } = Astro.props;
---

<Header
  title={`${study.name} · Case Study · Michael J West`}
  description={study.summary}
>
  <article class="pb-4">
    <!-- 1. HEADLINE + SUMMARY -->
    <section class="px-6 pt-10 pb-8">
      <div class="max-w-4xl mx-auto">
        <a
          href="/case-studies"
          class="inline-flex items-center gap-1 text-sm font-medium text-base-content/60 hover:text-base-content"
        >
          <span aria-hidden="true">←</span> All case studies
        </a>
        <span
          class="mt-6 inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary"
        >
          Case study
        </span>
        <h1
          class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl"
        >
          {study.name}
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-base-content/70">
          {study.summary}
        </p>
        {
          study.links.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
              {study.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- 2. ROLE & PROJECT FACTS -->
    <section class="px-6 pb-10">
      <div class="max-w-4xl mx-auto">
        <dl
          class="grid grid-cols-2 gap-px overflow-hidden rounded-box border border-base-300 bg-base-300 sm:grid-cols-4"
        >
          {
            study.facts.map((fact) => (
              <div class="bg-base-100 p-4">
                <dt class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
                  {fact.label}
                </dt>
                <dd class="mt-1 text-sm font-semibold text-base-content">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 3. OUTCOME HIGHLIGHTS -->
    <section class="bg-base-300 px-6 py-12">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-semibold tracking-tight">Outcome</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            study.outcomes.map((outcome) => (
              <div class="rounded-box border border-base-300 bg-base-100 p-6">
                <strong class="block text-3xl font-bold tracking-tight text-primary">
                  {outcome.stat}
                </strong>
                <span class="mt-1 block text-sm text-base-content/70">
                  {outcome.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4. SCANNABLE NARRATIVE + 6. VISUAL EVIDENCE -->
    <section class="px-6 py-14">
      <div class="max-w-4xl mx-auto grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div>
          {
            study.narrative.map((block) => (
              <div class="mb-7 last:mb-0">
                <h2 class="text-xl font-semibold tracking-tight">
                  {block.heading}
                </h2>
                <p class="mt-2 text-base-content/70">{block.body}</p>
              </div>
            ))
          }
          <div class="mt-8">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-base-content/50">
              Key features
            </h3>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {
                study.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-base-content/80">
                    <span class="mt-0.5 font-bold text-primary" aria-hidden="true">
                      →
                    </span>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Visual evidence -->
        <div class="lg:sticky lg:top-6">
          {
            study.media.map((item) =>
              item.type === "image" ? (
                <figure class="overflow-hidden rounded-box border border-base-300 bg-base-100">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    class="w-full"
                  />
                  {item.caption && (
                    <figcaption class="px-4 py-3 text-xs text-base-content/50">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              ) : (
                <figure class="overflow-hidden rounded-box border border-base-300 bg-base-100">
                  <div class="cs-video">
                    <iframe
                      src={item.src}
                      title={item.title}
                      loading="lazy"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </div>
                  {item.caption && (
                    <figcaption class="px-4 py-3 text-xs text-base-content/50">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- 5. TECHNICAL DETAIL (expand/collapse) -->
    <section class="px-6 pb-14">
      <div class="max-w-4xl mx-auto">
        <details
          class="group rounded-box border border-base-300 bg-base-100 open:shadow-sm"
        >
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 p-6"
          >
            <span>
              <span class="text-xl font-semibold tracking-tight">
                Technical detail
              </span>
              <span class="mt-0.5 block text-sm text-base-content/60">
                Stack, integrations, and the harder problems.
              </span>
            </span>
            <span
              class="shrink-0 text-2xl leading-none text-base-content/50 transition group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="border-t border-base-300 px-6 py-6">
            <div class="flex flex-wrap gap-2">
              {
                study.tech.stack.map((item) => (
                  <span class="rounded-full bg-base-200 px-3 py-1 text-xs font-medium text-base-content/80">
                    {item}
                  </span>
                ))
              }
            </div>
            {
              study.tech.integrations && study.tech.integrations.length > 0 && (
                <p class="mt-4 text-sm text-base-content/60">
                  <span class="font-semibold text-base-content/80">
                    Integrations:{" "}
                  </span>
                  {study.tech.integrations.join(", ")}
                </p>
              )
            }
            <ul class="mt-5 space-y-3">
              {
                study.tech.highlights.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm text-base-content/80">
                    <span
                      class="mt-0.5 font-bold text-primary"
                      aria-hidden="true"
                    >
                      →
                    </span>
                    {point}
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </section>

    <!-- 7. RELATED SERVICE -->
    <section class="bg-base-300 px-6 py-12">
      <div class="max-w-4xl mx-auto">
        <span
          class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
          >Related service</span
        >
        <div
          class="mt-3 flex flex-col gap-4 rounded-box border border-base-300 bg-base-100 p-6 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h2 class="text-lg font-semibold tracking-tight">
              {study.relatedService.title}
            </h2>
            <p class="mt-1 max-w-xl text-sm text-base-content/70">
              {study.relatedService.description}
            </p>
          </div>
          <a
            href={study.relatedService.href}
            class="btn btn-primary btn-sm shrink-0 self-start sm:self-auto"
            >See the service</a
          >
        </div>
      </div>
    </section>

    <!-- 8. PREV / NEXT NAV -->
    <section class="px-6 py-12">
      <div class="max-w-4xl mx-auto grid gap-4 sm:grid-cols-2">
        {
          prev ? (
            <a
              href={`/case-studies/${prev.slug}`}
              class="group rounded-box border border-base-300 bg-base-100 p-5 transition hover:border-base-content/40"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
                ← Previous
              </span>
              <span class="mt-1 block font-semibold group-hover:text-primary">
                {prev.name}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={`/case-studies/${next.slug}`}
              class="group rounded-box border border-base-300 bg-base-100 p-5 text-right transition hover:border-base-content/40 sm:col-start-2"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
                Next →
              </span>
              <span class="mt-1 block font-semibold group-hover:text-primary">
                {next.name}
              </span>
            </a>
          )
        }
      </div>
    </section>

    <!-- 9. CONTACT CTA -->
    <section class="bg-base-300 px-6 py-14">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-semibold tracking-tight">
          Want a result like this?
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-base-content/70">
          Tell me what you're building or what's in the way. I read every message
          and reply within one business day.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3.5">
          <a href="/#work-with-me" class="btn btn-primary">Start a conversation</a>
          <a
            href="mailto:23mwest@gmail.com"
            class="btn border-base-300 bg-base-100 font-semibold text-base-content shadow-none hover:border-base-content/40"
            >Email me</a
          >
        </div>
      </div>
    </section>
  </article>
</Header>

<style>
  .cs-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .cs-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
